{
  "keep": [
    "build/ui-tests/dd"
  ],
  "workspaces": 1,
  "checks": [
    {
      "name": "x1kit",
      "run": "swift test --package-path X1Kit",
      "inputs": [
        "X1Kit"
      ],
      "line": "build",
      "timeout": 10
    },
    {
      "name": "ui",
      "run": "s=$(xcrun simctl list devices | grep -F 'Artemis Build (' | grep -oE '[0-9A-F-]{36}' | head -1); [ -n \"$s\" ] || { echo 'No Artemis Build Simulator'; exit 1; }; xcrun simctl boot \"$s\" 2>/dev/null; xcrun simctl bootstatus \"$s\" >/dev/null && SIM=$s APPEARANCES=light Scripts/ui-tests.sh; r=$?; xcrun simctl shutdown $s 2>/dev/null; exit $r",
      "inputs": [
        "**",
        "!**/*.md",
        "!Screenshots/**",
        "!docs/**",
        "!Scripts/asc.py",
        "!Scripts/testflight.sh",
        "!Scripts/pad-parity/**",
        "!.github/**",
        "!appveyor.yml"
      ],
      "line": "sim-artemis",
      "timeout": 90,
      "select": {
        "env": "UI_TESTS",
        "always": [
          "ScreenshotTests/testStreamStartsAndReturns",
          "ScreenshotTests/testEveryScreenUprightDefaultText"
        ],
        "rules": [
          {
            "paths": [
              "Artemis/Desktop/OnScreenGamepad.swift",
              "Artemis/Desktop/PadTouch.swift",
              "Artemis/Desktop/PadHitTesting.swift",
              "ArtemisUITests/OnScreenGamepadTests.swift"
            ],
            "tests": [
              "OnScreenGamepadTests"
            ]
          },
          {
            "paths": [
              "Artemis/Desktop/GamepadMouse.swift",
              "ArtemisUITests/ControllerTests.swift"
            ],
            "tests": [
              "ControllerTests"
            ]
          },
          {
            "paths": [
              "Artemis/Desktop/KeyRow.swift",
              "Artemis/Desktop/ControlBar.swift",
              "Artemis/Desktop/TouchInterpreter.swift",
              "ArtemisUITests/DesktopTests.swift"
            ],
            "tests": [
              "DesktopTests",
              "OnScreenGamepadTests"
            ]
          },
          {
            "paths": [
              "Artemis/Views/ComputerInfoView.swift",
              "Artemis/Views/AddComputerView.swift",
              "Artemis/Views/PairingView.swift",
              "ArtemisUITests/ComputerTests.swift"
            ],
            "tests": [
              "ComputerTests",
              "ScreenshotTests"
            ]
          },
          {
            "paths": [
              "Artemis/Views/SettingsView.swift"
            ],
            "tests": [
              "ComputerTests",
              "ScreenshotTests",
              "DesktopTests/testScrollDirectionMovesToNaturalOnce"
            ]
          },
          {
            "paths": [
              "ArtemisUITests/ScreenshotTests.swift"
            ],
            "tests": [
              "ScreenshotTests"
            ]
          },
          {
            "paths": [
              "Artemis/AppIcon.icon/**",
              "ArtemisUITests/HomeScreenIconTests.swift"
            ],
            "tests": [
              "HomeScreenIconTests"
            ]
          },
          {
            "paths": [
              "ArtemisUITests/LiveHostTests.swift",
              "Artemis/Fonts/OFL.txt"
            ],
            "tests": []
          }
        ]
      }
    },
    {
      "name": "ui-dark",
      "run": "s=$(xcrun simctl list devices | grep -F 'Artemis Build (' | grep -oE '[0-9A-F-]{36}' | head -1); [ -n \"$s\" ] || { echo 'No Artemis Build Simulator'; exit 1; }; xcrun simctl boot \"$s\" 2>/dev/null; xcrun simctl bootstatus \"$s\" >/dev/null && SIM=$s APPEARANCES=dark Scripts/ui-tests.sh; r=$?; xcrun simctl shutdown $s 2>/dev/null; exit $r",
      "line": "sim-artemis",
      "nightly": true,
      "timeout": 90
    }
  ],
  "release": {
    "run": "mercurius-agent secret run --env ASC_KEY_ID,ASC_ISSUER_ID,ASC_KEY_P8 -- Scripts/testflight.sh",
    "inputs": [
      "**",
      "!**/*.md",
      "!docs/**",
      "!.mercurius/**"
    ],
    "line": "build",
    "timeout": 60
  }
}
