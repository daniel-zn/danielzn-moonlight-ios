<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Wake-on-LAN broadcast its magic packet (iOS 14.5+ blocks UDP broadcast and multicast
	     without it). Apple granted it for com.danielzn.artemis; the app target signs with this file:
	     README, "Waking a PC". -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
